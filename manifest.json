{
    "manifest_version": 3,
    "name": "LehighRMP - Professor Ratings",
    "description": "See RateMyProfessors.com ratings in Lehigh's Plan Ahead, Browse Classes and Register for Classes.",
    "version": "1.2",
    "icons": {
        "128": "assets/icon128.png"
    },
    "host_permissions": [
        "https://www.ratemyprofessors.com/*",
        "https://ratemyprofessors.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["https://reg-prod.ec.lehigh.edu/StudentRegistrationSsb/ssb/*"],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ]
}
